    {
      "name": "auth.local_auth_client_detail",
      "type": "VIEW",
      "columns": [
        {
          "name": "active",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "actor_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "client_id",
          "type": "text",
