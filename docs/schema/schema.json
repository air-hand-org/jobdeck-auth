          "type": "text",
          "nullable": true
        },
        {
          "name": "type",
          "type": "varchar(30)",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW local_auth_client_detail AS (\n SELECT c.actor_id,\n    c.client_id,\n    c.secret_hash,\n    a.name,\n    a.type,\n    a.active\n   FROM (auth.local_auth_client_credential c\n     JOIN auth.actor a USING (actor_id))\n)",
      "referenced_tables": [
        "auth.local_auth_client_credential",
        "auth.actor"
      ]
    }
